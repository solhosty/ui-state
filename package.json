{
  "name": "screen-state-explorer",
  "version": "0.1.0",
  "description": "A local tool for recording and replaying observed HTTP-driven screen states.",
  "type": "module",
  "bin": {
    "screen-explorer": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "explore": "npm run build --silent && node dist/cli.js explore",
    "test": "npm run build && node scripts/test.mjs",
    "start": "npm run build --silent && node dist/cli.js dashboard",
    "browser:install": "playwright install chromium",
    "prepack": "npm run build",
    "verify": "npm run format:check && npm run check && npm test",
    "demo:verify": "npm run build --silent && node dist/demo-verify.js",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "dev": "npm run build --silent && node scripts/dev.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright": "^1.55.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2"
  },
  "license": "MIT"
}
